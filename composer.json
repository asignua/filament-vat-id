{
    "name": "asignua/filament-vat-id",
    "description": "Tax ID and VAT number validation for Filament: offline format and checksum rules for EU VAT, PL NIP/REGON, CZ IČO/DIČ and UA ЄДРПОУ/РНОКПП, plus an input that looks companies up in VIES, ARES, the Polish white list and GUS.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "vat",
        "vies",
        "nip",
        "regon",
        "ico",
        "edrpou",
        "tax-id",
        "validation"
    ],
    "homepage": "https://github.com/asignua/filament-vat-id",
    "support": {
        "issues": "https://github.com/asignua/filament-vat-id/issues",
        "source": "https://github.com/asignua/filament-vat-id"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-dom": "*",
        "ext-simplexml": "*",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentVatId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentVatId\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentVatId\\VatIdServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "asignua/filament-iban": "IBAN input to combine with the bank accounts a lookup returns (no dependency)."
    }
}
